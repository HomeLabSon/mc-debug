#!/bin/bash
# SPDX-License-Identifier: MIT
# mc-debug - read-only troubleshooting helper for mailcow-dockerized
# Needs: root or docker access on the mailcow host, Docker Compose v2.
# Parsing of imapsync reports tested with imapsync 2.178 and 2.314 (bundled with mailcow).
set -u
MAILCOW_DIR="${MAILCOW_DIR:-/opt/mailcow-dockerized}"

die() { echo "mc-debug: $*" >&2; exit 1; }
norm_period() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+[smhd]$ ]] || die "invalid period '$p' (use e.g. 30m, 3h, 2d)"
  if [[ "$p" == *d ]]; then echo "$(( ${p%d} * 24 ))h"; else echo "$p"; fi
}
[ -f "$MAILCOW_DIR/docker-compose.yml" ] || die "no mailcow found in $MAILCOW_DIR (set MAILCOW_DIR)"
cd "$MAILCOW_DIR" || exit 1
docker compose version >/dev/null 2>&1 || die "Docker Compose v2 not found"

sql()  { docker compose exec -T mysql-mailcow sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" mailcow "$@"' _ "$@"; }
dove() { docker compose exec -T dovecot-mailcow doveadm "$@"; }

usage() {
  cat <<USAGE
mc-debug <command>
  sync                      status of all IMAP sync jobs (stuck job? see min_ago/running)
  syncreport <job-id>       short report of the last run of one sync job
  runner                    running imapsync processes and the parallel limit
  box [user@domain]         message count per user, or per folder for one user
  find <user@domain> <text> find mails by subject text in all folders
  trace <text> [period]     search postfix/rspamd/dovecot logs (period e.g. 30m, 3h, 2d; default 3h)
  errors [period] [all]     postfix/dovecot problems grouped by message, scanner noise hidden (default 24h)
  stats [period]            short mail statistics: counts, rspamd actions, top domains (default 24h)
  spam [period]             rspamd actions, postfix rejects, top flagged senders, quarantine count (default 24h)
  findspam <text> [period]  flagged/rejected mails matching sender, recipient or IP, plus junk folder search
  mailtrace <message-id> [period]  where did a mail go? rspamd decisions, postfix delivery, dovecot filing (default 72h)
USAGE
}

case "${1:-}" in
  sync)
    sql -e "select id, user2 as target, user1 as source, last_run,
            timestampdiff(minute, last_run, now()) as min_ago,
            is_running as running, exit_status
            from imapsync order by last_run" | { command -v column >/dev/null && column -t -s "$(printf "\t")" || cat; } ;;
  syncreport)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || die "usage: mc-debug syncreport <job-id>"
    sql -N -B -e "select returned_text from imapsync where id=$2" | sed 's/\\n/\n/g' \
      | grep -E 'Transfer (started|ended) on|Host1: folder .* has [0-9]+ messages in total|Messages (transferred|deleted on host1)|Detected' ;;
  runner)
    docker compose exec -T dovecot-mailcow sh -c 'date; ps -eo pid,etime,time,args | grep "[i]mapsync " | cut -c1-110'
    printf 'max_parallel: '
    sql -N -B -e "select value from imapsync_settings where name='max_parallel'" 2>/dev/null || echo "n/a (older mailcow: one job at a time)" ;;
  box)
    if [ -z "${2:-}" ]; then
      sql -N -B -e "select username from mailbox order by username" | while read -r u; do
        n=$(dove mailbox status -u "$u" messages '*' </dev/null 2>/dev/null | awk -F'messages=' '{s+=$2} END{print s+0}')
        printf '%8s  %s\n' "$n" "$u"
      done | sort -rn | awk '{t+=$1; print} END{printf "%8d  TOTAL\n", t}'
    else
      dove mailbox status -u "$2" messages '*'
    fi ;;
  find)
    [ -n "${3:-}" ] || die "usage: mc-debug find <user@domain> <subject text>"
    command -v python3 >/dev/null || die "python3 not found"
    dove fetch -u "$2" "mailbox date.saved hdr.subject" all subject "$3" | python3 -c '
import re, sys
from email.header import decode_header, make_header
for b in re.split(r"\n\s*\n", sys.stdin.read()):
    d = {}
    for l in b.splitlines():
        k, _, v = l.partition(": ")
        d[k] = v
    if d:
        s = str(make_header(decode_header(d.get("hdr.subject", ""))))
        print("%s  %-26s %s" % (d.get("date.saved", ""), d.get("mailbox", ""), s))
' | sort ;;
  trace)
    [ -n "${2:-}" ] || die "usage: mc-debug trace <text> [period]"
    p=$(norm_period "${3:-3h}") || exit 1
    docker compose logs --since "$p" postfix-mailcow rspamd-mailcow dovecot-mailcow \
      | grep -F -- "$2" | cut -c1-300 ;;
  errors)
    p=$(norm_period "${2:-24h}") || exit 1
    noise='SSL_accept\(\) failed|TLS library problem|TLS SNI from|non-SMTP command|does not resolve to address'
    docker compose logs --no-color --since "$p" postfix-mailcow dovecot-mailcow 2>/dev/null \
      | grep -iE ' (warning|error|fatal|panic):|status=(deferred|bounced)|NOQUEUE: reject' \
      | sed -E 's/^[a-z0-9-]+ +\| //; s/^[A-Z][a-z]{2} +[0-9]+ [0-9:]+ [^ ]+ //; s/[0-9A-F]{10,12}: //; s/\[[0-9]+\]/[]/; s/[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/IP/g; s/<[^>]*>/<x>/g; s/delays?=[^ ]*//g; s/sasl_username=[^ ,]*/sasl_username=<x>/' \
      | { if [ "${3:-}" = all ]; then cat; else grep -vE "$noise"; fi; } \
      | cut -c1-160 | sort | uniq -c | sort -rn | head -20
    [ "${3:-}" = all ] || echo "(hidden: TLS handshake/scanner noise; 'mc-debug errors ${2:-24h} all' shows everything)" ;;
  spam)
    p=$(norm_period "${2:-24h}") || exit 1
    t=$(mktemp); trap 'rm -f "$t"' EXIT
    docker compose logs --no-color --since "$p" rspamd-mailcow postfix-mailcow >"$t" 2>/dev/null
    echo "== spam analysis, last $p =="
    echo "-- rspamd actions (log lines; greylisted mails appear once per attempt)"
    grep 'rspamd_task_write_log' "$t" | grep -o '(default: [TF] ([a-z ]*)' | sed 's/(default: [TF] //' | sort | uniq -c | sort -rn
    echo "-- rejected by postfix (NOQUEUE: reject), top reasons"
    grep 'NOQUEUE: reject' "$t" | sed -E 's/.*reject: //; s/from=<[^>]*>.*//; s/[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/IP/g; s/<[^>]*>/<x>/g; s/\[[^]]*\]/[]/g' | cut -c1-120 | sort | uniq -c | sort -rn | head -5
    echo "-- top senders of flagged mails (rspamd action other than 'no action')"
    grep 'rspamd_task_write_log' "$t" | grep -v '(no action)' | grep -o ' from: <[^>]*>' | sed 's/ from: //' | sort | uniq -c | sort -rn | head -5
    printf 'quarantine entries (all time): %s\n' "$(sql -N -B -e 'select count(*) from quarantine' 2>/dev/null || echo n/a)" ;;
  findspam)
    [ -n "${2:-}" ] || die "usage: mc-debug findspam <text> [period]  (text: part of sender, recipient, IP or subject)"
    command -v python3 >/dev/null || die "python3 not found"
    p=$(norm_period "${3:-24h}") || exit 1
    echo "== rspamd: flagged mails matching '$2', last $p =="
    docker compose logs --no-color --since "$p" rspamd-mailcow 2>/dev/null | grep 'rspamd_task_write_log' | grep -F -i -- "$2" | python3 -c '
import re, sys
for l in sys.stdin:
    m = re.search(r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) .*? from: <([^>]*)>, \(default: [TF] \(([a-z ]+)\): \[(-?[\d.]+)/", l)
    if not m:
        continue
    t, frm, act, sc = m.groups()
    if act == "no action":
        continue
    rc = re.search(r"rcpts: <([^>]*)>", l)
    syms = re.findall(r"([A-Z][A-Z0-9_]+)\((-?[\d.]+)\)", l.split("]), len")[0])
    syms = sorted(syms, key=lambda x: -float(x[1]))[:3]
    print("%s  %-11s %6s  %s -> %s  %s" % (t, act, sc, frm.split("@")[-1][:45], rc.group(1) if rc else "?", " ".join("%s(%s)" % s for s in syms)))
'
    echo "== postfix: rejected at the door, matching '$2' =="
    docker compose logs --no-color --since "$p" postfix-mailcow 2>/dev/null | grep 'NOQUEUE: reject' | grep -F -i -- "$2" | sed -E 's/^[a-z0-9-]+ +\| //' | cut -c1-200 | head -10
    case "${p: -1}" in s) unit=seconds;; m) unit=minutes;; *) unit=hours;; esac
    sd=$(date -d "-${p%?} $unit" +%Y-%m-%d 2>/dev/null || echo 1970-01-01)
    echo "== junk folders: sender or subject matching '$2', received since $sd =="
    sql -N -B -e "select username from mailbox order by username" | while read -r u; do
      out=$(dove fetch -u "$u" "mailbox date.received hdr.from hdr.subject" mailbox Junk since "$sd" \( SUBJECT "$2" OR FROM "$2" \) </dev/null | python3 -c '
import re, sys
from email.header import decode_header, make_header
def dec(v):
    try:
        return str(make_header(decode_header(v)))
    except Exception:
        return v
for b in re.split(r"\n\s*\n", sys.stdin.read()):
    d = {}
    for l in b.splitlines():
        k, _, v = l.partition(": ")
        d[k] = v
    if d:
        print("  %s  %-40s %s" % (d.get("date.received", ""), dec(d.get("hdr.from", ""))[:40], dec(d.get("hdr.subject", ""))[:70]))
')
      if [ -n "$out" ]; then echo "$u"; echo "$out" | sort -r | head -15; fi
    done ;;
  mailtrace)
    [ -n "${2:-}" ] || die "usage: mc-debug mailtrace <message-id or part of it> [period]"
    command -v python3 >/dev/null || die "python3 not found"
    p=$(norm_period "${3:-72h}") || exit 1
    t=$(mktemp); trap 'rm -f "$t"' EXIT
    docker compose logs --no-color --since "$p" rspamd-mailcow postfix-mailcow dovecot-mailcow >"$t" 2>/dev/null
    key="${2#<}"; key="${key%>}"
    qids=$(grep -F -- "$key" "$t" | grep -oE '(qid: <|cleanup\[[0-9]+\]: )[0-9A-F]{10,12}' | grep -oE '[0-9A-F]{10,12}$' | sort -u | paste -sd'|')
    echo "== rspamd decisions for '$key' =="
    grep 'rspamd_task_write_log' "$t" | grep -F -- "$key" | python3 -c '
import re, sys
for l in sys.stdin:
    m = re.search(r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) .*? ip: ([^,]*), from: <([^>]*)>, \(default: [TF] \(([a-z ]+)\): \[(-?[\d.]+)/", l)
    if not m:
        continue
    t, ip, frm, act, sc = m.groups()
    rc = re.search(r"rcpts: <([^>]*)>", l)
    syms = re.findall(r"([A-Z][A-Z0-9_]+)\((-?[\d.]+)\)", l.split("]), len")[0])
    syms = sorted(syms, key=lambda x: -float(x[1]))[:3]
    print("%s  %-11s %6s  ip %s -> %s  %s" % (t, act, sc, ip, rc.group(1) if rc else "?", " ".join("%s(%s)" % s for s in syms)))
'
    echo "== postfix (queue ids: ${qids:-none}) =="
    if [ -n "$qids" ]; then grep -E "postfix/.*: ($qids): " "$t" | sed -E 's/^[a-z0-9-]+ +\| //' | grep -E 'client=|from=<|to=<' | cut -c1-200; fi
    echo "== dovecot =="
    grep -F -- "$key" "$t" | grep 'dovecot' | sed -E 's/^[a-z0-9-]+ +\| //' | cut -c1-220 ;;
  stats)
    p=$(norm_period "${2:-24h}") || exit 1; t=$(mktemp); trap 'rm -f "$t"' EXIT
    docker compose logs --no-color --since "$p" postfix-mailcow dovecot-mailcow rspamd-mailcow >"$t" 2>/dev/null
    echo "== mail statistics, last $p =="
    tot=$(grep -c 'postfix/qmgr.*: from=<.*size=' "$t")
    doms=$(sql -N -B -e "select domain from domain union select alias_domain from alias_domain" 2>/dev/null | sed 's/\./\\./g' | paste -sd'|')
    if [ -n "$doms" ]; then
      loc=$(grep 'postfix/qmgr.*: from=<.*size=' "$t" | grep -cE "from=<[^>]*@($doms)>")
      printf 'queued            : %s (own domains: %s, external: %s)\n' "$tot" "$loc" "$((tot-loc))"
    else
      printf 'queued            : %s\n' "$tot"
    fi
    printf 'delivered local   : %s\n' "$(grep -c 'postfix/lmtp.*status=sent' "$t")"
    printf 'sent outbound     : %s\n' "$(grep -c 'postfix/smtp\[.*status=sent' "$t")"
    printf 'deferred          : %s\n' "$(grep -c 'status=deferred' "$t")"
    printf 'bounced           : %s\n' "$(grep -c 'status=bounced' "$t")"
    printf 'rejected          : %s\n' "$(grep -c 'NOQUEUE: reject' "$t")"
    printf 'IMAP/POP logins   : %s\n' "$(grep -c 'Login: user=<' "$t")"
    echo "-- rspamd actions"
    grep -o 'default: [FT] ([a-z ]*)' "$t" | sed 's/default: [FT] //' | sort | uniq -c | sort -rn
    echo "-- top sender domains (received)"
    grep 'postfix/qmgr.*: from=<' "$t" | grep -o 'from=<[^>]*@[^>]*>' | sed 's/.*@//; s/>//' | sort | uniq -c | sort -rn | head -5
    echo "-- top recipient domains (sent outbound)"
    grep 'postfix/smtp\[.*status=sent' "$t" | grep -o ' to=<[^>]*@[^>]*>' | sed 's/.*@//; s/>//' | sort | uniq -c | sort -rn | head -5 ;;
  *) usage ;;
esac
