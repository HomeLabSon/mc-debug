#!/bin/bash
# SPDX-License-Identifier: MIT
# mc-debug - read-only troubleshooting helper for mailcow-dockerized
# Needs: root or docker access on the mailcow host, Docker Compose v2.
# Parsing of imapsync reports tested with imapsync 2.178 (bundled with mailcow).
set -u
MAILCOW_DIR="${MAILCOW_DIR:-/opt/mailcow-dockerized}"

die() { echo "mc-debug: $*" >&2; exit 1; }
[ -f "$MAILCOW_DIR/docker-compose.yml" ] || die "no mailcow found in $MAILCOW_DIR (set MAILCOW_DIR)"
cd "$MAILCOW_DIR" || exit 1
docker compose version >/dev/null 2>&1 || die "Docker Compose v2 not found"

sql()  { docker compose exec -T mysql-mailcow sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" mailcow "$@"' _ "$@"; }
dove() { docker compose exec -T dovecot-mailcow doveadm "$@"; }

usage() {
  cat <<USAGE
mc-debug <command>
  sync                      status of all IMAP sync jobs (stuck job? see min_ago/running)
  syncreport <job-id>       short report of the last run of one sync job
  runner                    is imapsync running right now? is the lock present?
  box [user@domain]         message count per user, or per folder for one user
  find <user@domain> <text> find mails by subject text in all folders
  trace <text> [period]     search postfix/rspamd/dovecot logs (period e.g. 30m, 3h, 2d; default 3h)
  errors [period] [all]     postfix/dovecot problems grouped by message, scanner noise hidden (default 24h)
  stats [period]            short mail statistics: counts, rspamd actions, top domains (default 24h)
USAGE
}

case "${1:-}" in
  sync)
    sql -e "select id, user2 as target, user1 as source, last_run,
            timestampdiff(minute, last_run, now()) as min_ago,
            is_running as running, exit_status
            from imapsync order by last_run" ;;
  syncreport)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || die "usage: mc-debug syncreport <job-id>"
    sql -N -B -e "select returned_text from imapsync where id=$2" | sed 's/\\n/\n/g' \
      | grep -E 'Transfer (started|ended) on|Host1: folder .* has [0-9]+ messages in total|Messages (transferred|deleted on host1)|Detected' ;;
  runner)
    docker compose exec -T dovecot-mailcow sh -c \
      'date; ps -eo pid,etime,time,args | grep "[i]mapsync --tmpdir" | cut -c1-110; ls -l /tmp/imapsync_busy.lock 2>&1' ;;
  box)
    if [ -z "${2:-}" ]; then
      sql -N -B -e "select username from mailbox order by username" | while read -r u; do
        n=$(dove mailbox status -u "$u" messages '*' </dev/null 2>/dev/null | awk -F'messages=' '{s+=$2} END{print s+0}')
        printf '%8s  %s\n' "$n" "$u"
      done | sort -rn | awk '{t+=$1; print} END{printf "%8d  TOTAL\n", t}'
    else
      dove mailbox status -u "$2" messages '*'
    fi ;;
  find)
    [ -n "${3:-}" ] || die "usage: mc-debug find <user@domain> <subject text>"
    dove fetch -u "$2" "mailbox date.saved" all subject "$3" ;;
  trace)
    [ -n "${2:-}" ] || die "usage: mc-debug trace <text> [period]"
    docker compose logs --since "${3:-3h}" postfix-mailcow rspamd-mailcow dovecot-mailcow \
      | grep -F -- "$2" | cut -c1-300 ;;
  errors)
    noise='SSL_accept\(\) failed|TLS library problem|TLS SNI from|non-SMTP command|does not resolve to address'
    docker compose logs --no-color --since "${2:-24h}" postfix-mailcow dovecot-mailcow 2>/dev/null \
      | grep -iE ' (warning|error|fatal|panic):|status=(deferred|bounced)|NOQUEUE: reject' \
      | sed -E 's/^[a-z0-9-]+ +\| //; s/^[A-Z][a-z]{2} +[0-9]+ [0-9:]+ [^ ]+ //; s/[0-9A-F]{10,12}: //; s/\[[0-9]+\]/[]/; s/[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/IP/g; s/<[^>]*>/<x>/g; s/delays?=[^ ]*//g; s/sasl_username=[^ ,]*/sasl_username=<x>/' \
      | { if [ "${3:-}" = all ]; then cat; else grep -vE "$noise"; fi; } \
      | cut -c1-160 | sort | uniq -c | sort -rn | head -20
    [ "${3:-}" = all ] || echo "(hidden: TLS handshake/scanner noise; 'mc-debug errors ${2:-24h} all' shows everything)" ;;
  stats)
    p="${2:-24h}"; t=$(mktemp); trap 'rm -f "$t"' EXIT
    docker compose logs --no-color --since "$p" postfix-mailcow dovecot-mailcow rspamd-mailcow >"$t" 2>/dev/null
    echo "== mail statistics, last $p =="
    printf 'received (queued) : %s\n' "$(grep -c 'postfix/qmgr.*: from=<.*size=' "$t")"
    printf 'delivered local   : %s\n' "$(grep -c 'postfix/lmtp.*status=sent' "$t")"
    printf 'sent outbound     : %s\n' "$(grep -c 'postfix/smtp\[.*status=sent' "$t")"
    printf 'deferred          : %s\n' "$(grep -c 'status=deferred' "$t")"
    printf 'bounced           : %s\n' "$(grep -c 'status=bounced' "$t")"
    printf 'rejected          : %s\n' "$(grep -c 'NOQUEUE: reject' "$t")"
    printf 'IMAP/POP logins   : %s\n' "$(grep -c 'Login: user=<' "$t")"
    echo "-- rspamd actions"
    grep -o 'default: [FT] ([a-z ]*)' "$t" | sed 's/default: [FT] //' | sort | uniq -c | sort -rn
    echo "-- top sender domains (received)"
    grep 'postfix/qmgr.*: from=<' "$t" | grep -o 'from=<[^>]*@[^>]*>' | sed 's/.*@//; s/>//' | sort | uniq -c | sort -rn | head -5
    echo "-- top recipient domains (sent outbound)"
    grep 'postfix/smtp\[.*status=sent' "$t" | grep -o ' to=<[^>]*@[^>]*>' | sed 's/.*@//; s/>//' | sort | uniq -c | sort -rn | head -5 ;;
  *) usage ;;
esac
